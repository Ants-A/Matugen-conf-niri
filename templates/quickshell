pragma Singleton
import QtQuick
import Quickshell

Singleton {
    readonly property color background_dark: "{{ colors.surface.default.hex | set_lightness: 2.0 }}"
<* for name, color in colors *>
    readonly property color {{ name }}: "{{ color.default.hex }}"
<* endfor *>
<* for name, palette in palettes *><* for shade, color in palette *>
    readonly property color {{ name }}{{ shade }}: "{{ color.hex }}"
<* endfor *><* endfor *>
}

