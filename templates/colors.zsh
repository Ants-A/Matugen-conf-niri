# Generated by Matugen. Reloaded before each prompt when the palette changes.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{colors.outline.default.hex}}'

# The plugin is loaded before this file in .zshrc. Respect its active theme prefix.
if (( ${+FAST_HIGHLIGHT_STYLES} )); then
  FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}unknown-token]='fg={{colors.error.default.hex}},bold'
  for _matugen_style in command builtin function alias suffix-alias precommand hashed-command; do
    FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}${_matugen_style}]='fg={{colors.primary.default.hex}}'
  done
  for _matugen_style in single-hyphen-option double-hyphen-option; do
    FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}${_matugen_style}]='fg={{colors.tertiary.default.hex}}'
  done
  for _matugen_style in single-quoted-argument double-quoted-argument dollar-quoted-argument; do
    FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}${_matugen_style}]='fg={{colors.secondary.default.hex}}'
  done
  FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}comment]='fg={{colors.outline.default.hex}}'
  FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}reserved-word]='fg={{colors.primary.default.hex}}'
  unset _matugen_style
fi

if [[ -o interactive && -t 1 && $TERM != dumb ]]; then
  printf '\033]10;{{colors.on_background.default.hex}}\a\033]11;{{colors.surface.default.hex | set_lightness: 3.5}}\a\033]12;{{colors.primary.default.hex}}\a'
fi

if [[ -o interactive ]]; then
  typeset -g _matugen_colors_content="$(< ~/.cache/matugen/colors.zsh)"
  function _matugen_reload_colors() {
    local file=~/.cache/matugen/colors.zsh content
    [[ -r $file ]] || return
    content="$(< "$file")"
    if [[ $content != $_matugen_colors_content ]]; then
      source "$file"
    fi
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _matugen_reload_colors
fi
